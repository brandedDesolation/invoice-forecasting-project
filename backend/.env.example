# Application
APP_NAME="Invoice Forecasting API"
APP_VERSION="1.0.0"
DEBUG=false

# Database
DATABASE_URL=sqlite:///./invoice_forecast.db
# For PostgreSQL: postgresql://user:password@localhost:5432/invoice_forecast
DEBUG_SQL=false

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_ADMIN_EMAIL=admin@invoiceforecast.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Ipek Zeytin
DEFAULT_ADMIN_COMPANY=VICAI Finance Operations
GOOGLE_CLIENT_ID=

# API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.pdf

# Optional document extraction provider
DOCUMENT_EXTRACTION_PROVIDER=local
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
